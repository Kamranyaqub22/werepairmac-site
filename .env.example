# Copy to .env.local for local dev. In production these are set in the Vercel
# project's Environment Variables, NOT committed here.

# ─── Contact form (already live) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=info@werepairmac.co.uk

# ─── Reviews / analytics (already live) ─────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
NEXT_PUBLIC_CLARITY_ID=
BING_SITE_VERIFICATION=

# ─── /admin/repairs publishing console ──────────────────────────────────────

# The password you type at /admin/repairs. Use a long random one — it is the
# only thing standing between the internet and the publish button.
ADMIN_PASSWORD=

# Signs the admin session cookie. Must be at least 32 characters; the app
# refuses to start a session without it. Generate with:
#   openssl rand -hex 32
# Changing this value signs everyone out immediately, which is how you revoke
# a session you think is compromised.
ADMIN_SESSION_SECRET=

# Drafts the case study from the photos and your note.
ANTHROPIC_API_KEY=

# Commits the published repair. Use a FINE-GRAINED personal access token scoped
# to this one repository, with Contents: Read and write — nothing else. A
# classic token with `repo` scope would grant access to every repo you own.
GITHUB_TOKEN=
GITHUB_REPO=Kamranyaqub22/werepairmac-site
# Optional; defaults to main. Point at a branch to publish to a Vercel preview
# instead of production.
GITHUB_BRANCH=main
